/* New Terminal Actions */
{ "id" : "org.gnome.builder.terminal.new-in-host", "trigger" : "<Primary><Shift>t", "action" : "workspace.terminal.new-in-host", "args" : "''", "when" : "canEdit()", "phase" : "capture" },
{ "id" : "org.gnome.builder.terminal.new-in-pipeline", "trigger" : "<Primary><Alt><Shift>t", "action" : "workspace.terminal.new-in-pipeline", "args" : "''", "when" : "canEdit()", "phase" : "capture" },
{ "id" : "org.gnome.builder.terminal.new-in-runtime", "trigger" : "<Primary><Alt>t", "action" : "workspace.terminal.new-in-runtime", "args" : "''", "when" : "canEdit()", "phase" : "capture" },
{ "trigger" : "<Primary>Scroll_Lock", "action" : "workspace.terminal.new-in-subprocess", "args" : "''", "when" : "canEdit()", "phase" : "capture" },

/* IdeTerminal */
{ "trigger" : "<Primary><Shift>c", "action" : "clipboard.copy", "when" : "inTerminal()", "phase" : "capture" },
{ "trigger" : "<Primary><Shift>v", "action" : "clipboard.paste", "when" : "inTerminal()", "phase" : "capture" },
{ "trigger" : "<Primary><Shift>a", "action" : "terminal.select-all", "args" : "true", "when" : "inTerminal()", "phase" : "capture" },
{ "trigger" : "<Primary><Shift>f", "action" : "page.terminal.search", "when" : "inTerminal()", "phase" : "capture" },
{ "trigger" : "<Primary><Shift>braceleft", "action" : "page.move-left", "when" : "inTerminal()", "phase" : "capture" },
{ "trigger" : "<Primary><Shift>braceright", "action" : "page.move-right", "when" : "inTerminal()", "phase" : "capture" },

/* Allow closing exited terminals with ctrl+w */
{ "trigger" : "<Primary>w", "action" : "frame.close-page-or-frame", "when" : "(typeof(page) == typeof(Ide.TerminalPage)) && page.has_exited()", "phase" : "capture" },
